generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  emailVerified    Boolean        @default(false)
  vendeur          Boolean        @default(false)
  code             Int?
  address          String?
  image            String?
  certified        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  Articles         Articles[]
  Comments         Comments[]
  MessagesSent     Messages[]     @relation("Sender")
  MessagesReceived Messages[]     @relation("Receiver")
  OrdersBuyer      Orders[]       @relation("Buyer")
  OrdersSeller     Orders[]       @relation("Seller")
  Carts            Carts[]
  Account          Account[]
  Session          Session[]
  Numbers          Numbers[]
  Appreciations    ArticleNotes[]

  @@map("user")
}

model ArticleNotes {
  number     Int      @unique
  seller_id  String
  article_id String
  User       User     @relation(fields: [seller_id], references: [id])
  Articles   Articles @relation(fields: [article_id], references: [id])
}

model Categories {
  name        String  @id
  description String?
  image       String?
}

model Articles {
  id            String         @id @default(uuid())
  userId        String
  title         String
  images        String[]
  category      String[]
  description   String
  price         Int
  stock         Int
  rates         Float[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  User          User           @relation(fields: [userId], references: [id])
  Comments      Comments[]
  Messages      Messages[]
  Appreciations ArticleNotes[]
}

model Comments {
  id         String   @id @default(uuid())
  article_id String
  buyer_id   String
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Articles   Articles @relation(fields: [article_id], references: [id])
  User       User     @relation(fields: [buyer_id], references: [id])
}

model Messages {
  id          String    @id @default(uuid())
  message     String
  sender_id   String
  receiver_id String
  article_id  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Sender      User      @relation("Sender", fields: [sender_id], references: [id])
  Receiver    User      @relation("Receiver", fields: [receiver_id], references: [id])
  Articles    Articles? @relation(fields: [article_id], references: [id])
}

model Numbers {
  id        Int    @id
  number    Int    @unique
  seller_id String
  User      User   @relation(fields: [seller_id], references: [id])
}

model Carts {
  id      String @id @default(uuid())
  cart    Json
  user_id String
  User    User   @relation(fields: [user_id], references: [id])
}

model Orders {
  id              String   @id @default(uuid())
  article_details Json
  buyer_id        String
  seller_id       String
  order_status    String   @default("accepted")
  order_date      DateTime @default(now()) // champ ajouté
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Buyer           User     @relation("Buyer", fields: [buyer_id], references: [id])
  Seller          User     @relation("Seller", fields: [seller_id], references: [id])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
